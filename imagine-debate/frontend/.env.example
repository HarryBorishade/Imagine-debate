NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Optional — canonical production URL used in metadata/sitemap/robots.
# Falls back to NEXT_PUBLIC_APP_URL, then a placeholder, if unset.
NEXT_PUBLIC_SITE_URL=

# Optional — shown on the contact/privacy/FAQ pages. Falls back to
# debateimagine@gmail.com if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional — Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Analytics
# is never loaded unless this is set AND the visitor accepts the cookie
# consent banner — leaving this blank disables analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
